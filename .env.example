# Copie para .env e preencha. O .env esta no .gitignore.

# Use aspas simples nos valores - senhas costumam ter ! $ e outros caracteres
# que o shell interpreta.
# Sandbox/MTF:   https://mtf.services.mastercard.com/loyalty/benefits
# Producao:      https://services.mastercard.com/loyalty/benefits
MC_BASE_URL=https://mtf.services.mastercard.com/loyalty/benefits

# Keystore PKCS#12 com o certificado mTLS + chave privada.
# Gere com ./make-p12.sh a partir do .crt + .key que o portal entrega.
MC_P12='certs/mtls-client.p12'
MC_P12_PASS=''

# Client Encryption Key: o certificado .pem que a Mastercard fornece no
# dashboard do projeto. Fica em PEM mesmo - nao converta para p12.
# ATENCAO: sandbox e producao usam certificados DIFERENTES.
MC_ENC_CERT='certs/client-encryption-key.pem'

# Opcional - so se a resposta voltar cifrada (veja o README).
MC_DEC_P12=
MC_DEC_P12_PASS=''
